<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/field_background">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ELLESON CONNECT" android:textSize="12sp" android:textStyle="bold" android:textColor="#41DEC9" android:paddingBottom="6dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <Button android:id="@+id/widgetScreen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Screen" android:textAllCaps="false" android:textColor="#E1F4FF" android:backgroundTint="#143746" />
    <Button android:id="@+id/widgetFiles" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Files" android:textAllCaps="false" android:textColor="#E1F4FF" android:backgroundTint="#143746" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <Button android:id="@+id/widgetAudio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Audio" android:textAllCaps="false" android:textColor="#E1F4FF" android:backgroundTint="#143746" />
    <Button android:id="@+id/widgetKeyboard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Keyboard" android:textAllCaps="false" android:textColor="#E1F4FF" android:backgroundTint="#143746" />
  </LinearLayout>
</LinearLayout>
